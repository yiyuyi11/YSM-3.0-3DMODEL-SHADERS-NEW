+        return gfx::bake::BakeModel(StrBuf(protobuf), texture, {.origin_ver = 29}).ok();
+    };
+    EXPECT_TRUE(bakes(MakePendulumPair(true, true)));
+    auto model = MakePendulumPair(true, false);
+    model.springs->links[0].b = 2;  // not a joint's bone
