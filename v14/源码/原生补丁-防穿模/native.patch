+TEST(AntiClipTest, RejectsMalformedLinks) {
+    InitCpuInfo();
+    std::array<gfx::bake::Pixel, 4> pixels{};
+    gfx::bake::Texture texture(pixels.data(), 2, 2);
+    const auto bakes = [&](const model_proto::GeoModel& model) {
