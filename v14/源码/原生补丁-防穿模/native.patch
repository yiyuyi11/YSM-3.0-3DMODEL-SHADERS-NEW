+    model = MakePendulumPair(true, false);
+    model.springs->links[0].b = 1;  // itself
+    EXPECT_FALSE(bakes(model));
+    model = MakePendulumPair(true, false);
+    model.springs->link_compression = 1.5f;
+    EXPECT_FALSE(bakes(model));
+    model = MakePendulumPair(false, true);
+    model.springs->joints[0].sync = 2;  // no capsule 1
+    EXPECT_FALSE(bakes(model));
+}
