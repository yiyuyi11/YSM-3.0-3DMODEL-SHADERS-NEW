+// v turned by the unit quaternion q (xyzw).
+Vec3 QuatRotate(const std::array<float, 4>& q, const Vec3& v) {
+    const Vec3 axis{q[0], q[1], q[2]};
+    const auto t = Scale(Cross(axis, v), 2.0f);
+    return Add(Add(v, Scale(t, q[3])), Cross(axis, t));
